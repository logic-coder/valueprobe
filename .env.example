# Data transport for a static host: "proxy" (dev default) uses the Vite proxy,
# "direct" calls upstreams straight (only CORS-safe hosts), "gateway" wraps
# non-CORS hosts in VITE_CORS_GATEWAY. Builds default to "direct".
# VITE_TRANSPORT=direct

# Needed only for self-hosted live SEC EDGAR / Eastmoney requests. {url} is URL-encoded.
# Use a gateway you run. Forward a contact User-Agent to data.sec.gov.
# The default static build reads committed snapshots and embeds no gateway.
# VITE_CORS_GATEWAY=https://example.com/proxy?url={url}

# US source order: auto | hybrid | edgar | eastmoney
# VITE_US_SOURCE=auto

# Quarterly files under public/data/. Set "off" to ignore them while debugging a live feed.
# VITE_SNAPSHOT=off

# Bundled snapshots only, no network: fixture
# VITE_API_MODE=fixture

# Sub-path for project pages, e.g. /fairvalue/ (the Pages workflow sets it from the repo name)
# VITE_BASE=/

# Absolute origin for canonical/OG tags (the Pages workflow fills this from the repo).
# VITE_SITE_URL=https://owner.github.io/repo/
